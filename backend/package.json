{
  "name": "store-management",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "Dionmar A. Lariosa",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc && npm run start",
    "eslint:scan": "npx eslint .",
    "prettier:scan": "npx prettier . --check",
    "prettier:format": "npx prettier . --write",
    "migrate:create": " node-pg-migrate create",
    "migrate:up": "dotenv -e .env.development -- node-pg-migrate up",
    "migrate:down": "dotenv -e .env.development -- node-pg-migrate down",
    "migrate:up:test": "dotenv -e .env.test -- node-pg-migrate up",
    "migrate:down:test": "dotenv -e .env.test -- node-pg-migrate down",
    "test:unit": "vitest tests/unit",
    "test:e2e": "cross-env NODE_ENV=test vitest tests/e2e",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "pino-http": "^11.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.0",
    "@eslint/markdown": "^8.0.2",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.9",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "node-pg-migrate": "^8.0.4",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.0",
    "prettier-plugin-embed": "^0.5.1",
    "prettier-plugin-sql": "^0.20.0",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  }
}